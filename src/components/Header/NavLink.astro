---
interface Props {
  href: string;
  active?: boolean;
}

const { href, active = false } = Astro.props;
const activeClass = active ? "text-active-highlight scale-110" : "";
---

<li
  class:list={[
    "duration-100 ease-in hover:scale-110 hover:text-cyan-400",
    activeClass,
  ]}
>
  <a rel="prefetch" href={href}>
    <slot />
  </a>
</li>
