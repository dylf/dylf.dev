---
import Icon from "@/components/Icon.astro";
import NavLink from "./NavLink.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<nav class="">
  <ul class="flex flex-1 justify-around text-xl font-light uppercase">
    <NavLink href="/" active={"/" === currentPath}>Home</NavLink>
    <!-- <NavLink href="/blog" active={"/blog" === currentPath}>Blog</NavLink> -->
    <NavLink href="/projects" active={"/projects" === currentPath}>
      Projects
    </NavLink>
    <NavLink href="/uses" active={"/uses" === currentPath}>Uses</NavLink>
    <NavLink href="/links" active={"/links" === currentPath}>Links</NavLink>
  </ul>
</nav>
