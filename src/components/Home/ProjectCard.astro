---
export interface Props {
  title: string;
  liveUrl: string;
  sourceUrl: string;
  description: string;
}

const { liveUrl, sourceUrl, title, description } = Astro.props;
---

<div
  class:list={[
    "p-5",
    "flex",
    "border-dashed",
    "border-4",
    "border-purple-900",
    "bg-white/5",
  ]}
>
  <div class:list={["mx-auto", "p-3", "w-full", "relative"]}>
    <h3 class="text-subheading text-xl">
      {title}
    </h3>
    <div class="mt-2 flex">
      <p class="text-gray-300">
        {description}
      </p>
    </div>
    <div class="mt-4 flex justify-end gap-4">
      <a
        class="border-input focus-visible:ring-ring hover:bg-bg-primary inline-flex h-8 items-center justify-center border px-4 text-sm font-medium shadow-sm transition-colors hover:border-cyan-400 hover:text-cyan-400 focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
        href={liveUrl}
        target="_blank"
      >
        View Project &rarr;
      </a>
      <a
        class="border-input focus-visible:ring-ring hover:bg-bg-primary inline-flex h-8 items-center justify-center border px-4 text-sm font-medium shadow-sm transition-colors hover:border-cyan-400 hover:text-cyan-400 focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
        href={sourceUrl}
        target="_blank"
      >
        GitHub &rarr;
      </a>
    </div>
  </div>
</div>
