---
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
---

<footer class="font mb-4 flex justify-around text-center text-xs text-gray-400">
  <Image src={"/skull-flame.gif"} alt="flaming skull" width="50" />
  <div class="flex-col">
    <div class="mb-3 flex flex-row justify-center">
      <a
        href="https://www.github.com/dylf"
        title="GitHub"
        class="m-2 h-8 w-8 hover:bg-purple-400"
        target="_blank"
      >
        <Image
          src={"/octocat.gif"}
          alt="github"
          width="32"
          height="32"
          loading="eager"
        />
      </a>
      <a
        href="https://www.x.com/shallowclone"
        title="Twitter"
        class="m-2 h-8 w-8 hover:bg-purple-400"
        target="_blank"
      >
        <Image
          src={"/twitter.gif"}
          alt="twitter"
          width="32"
          height="32"
          loading="eager"
        />
      </a>
      <a
        href="https://www.twitch.tv/shallowclone"
        title="Twitch"
        class="m-2 h-8 w-8 hover:bg-purple-400"
        target="_blank"
      >
        <Image
          src={"/twitch.gif"}
          alt="twitch"
          width="32"
          height="32"
          loading="eager"
        />
      </a>
      <a
        href="https://www.tiktok.com/@shallowclone"
        title="Twitch"
        class="m-2 h-8 w-8 hover:bg-purple-400"
        target="_blank"
      >
        <Image
          src={"/tiktok.gif"}
          alt="tiktok"
          width="32"
          height="32"
          loading="eager"
        />
      </a>
      <a
        href="https://ko-fi.com/shallowclone"
        title="Buy me a coffee"
        class="m-2 h-8 w-8 hover:bg-purple-400"
        target="_blank"
      >
        <Image
          src={"/kofi.gif"}
          alt="buy me a coffee"
          width="32"
          height="32"
          loading="eager"
        />
      </a>
    </div>
    <div>
      Copyright © Dylan 🛠️ Built with
      <a href="https://www.astro.build" class="underline hover:text-cyan-400">
        Astro</a
      >
      &
      <a href="https://tailwindcss.com" class="underline hover:text-cyan-400">
        tailwindcss</a
      >
    </div>
  </div>
  <Image
    src={"/skull-flame.gif"}
    alt="flaming skull"
    width="50"
    loading="eager"
  />
</footer>
