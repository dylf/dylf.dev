---
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
---

<footer class="font mb-4 flex justify-around text-center text-xs text-gray-400">
  <Image src={"/skull-flame.gif"} alt="flaming skull" width="50" />
  <div class="flex-col">
    <div class="mb-3 flex flex-row justify-center">
      <a
        href="https://www.github.com/dylf"
        title="GitHub"
        class="m-2 h-8 w-8 hover:bg-purple-400"
      >
        <Image src={"/octocat.gif"} alt="github" width="32" height="32" />
      </a>
      <a
        href="https://www.x.com/dylf"
        title="Twitter"
        class="m-2 h-8 w-8 hover:bg-purple-400"
      >
        <Image src={"/twitter.gif"} alt="twitter" width="32" height="32" />
      </a>
      <a
        href="https://www.twitch.tv/shallowclone"
        title="Twitch"
        class="m-2 h-8 w-8 hover:bg-purple-400"
      >
        <Image src={"/twitch.gif"} alt="twitch" width="32" height="32" />
      </a>
      <a
        href="https://www.linkedin.com/in/dylan-fontaine/"
        title="LinkedIn"
        class="m-2 h-8 w-8 hover:bg-purple-400"
      >
        <Image src={"/linkedin.gif"} alt="linked" width="32" height="32" />
      </a>
    </div>
    <div>
      Copyright © Dylan Fontaine 🛠️ Built with
      <a href="https://www.astro.build" class="underline hover:text-cyan-400">
        Astro</a
      >
      &
      <a href="https://tailwindcss.com" class="underline hover:text-cyan-400">
        tailwindcss</a
      >
    </div>
  </div>
  <Image src={"/skull-flame.gif"} alt="flaming skull" width="50" />
</footer>
