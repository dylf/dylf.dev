---
import "@fontsource/orienta";
import "@fontsource-variable/signika";
import "@fontsource-variable/work-sans/wght-italic.css";
import "@fontsource/victor-mono";

import globalStylesHref from "@/styles/global.css?url";

import { ClientRouter } from "astro:transitions";

export interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description } = Astro.props;
const canonicalUrl = `https://www.dylf.dev${Astro.url.pathname}`;
const pageTitle = `${title} | Dylan Fontaine`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="follow, index" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dylan Fontaine" />
    <meta property="og:image" content="https://www.dylf.dev/dylf-summary.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ShallowClone" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="stylesheet" href={globalStylesHref} />

    <link rel="icon" type="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class:list={["linktree"]}>
    <div class="container mx-auto max-w-200">
      <main class="flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
