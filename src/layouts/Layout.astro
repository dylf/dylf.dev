---
import "@fontsource/orienta";
import "@fontsource-variable/signika";
import "@fontsource-variable/work-sans/wght-italic.css";
import "@fontsource/victor-mono";

import SpeedInsights from "@vercel/speed-insights/astro";

import globalStylesHref from "@/styles/global.css?url";

import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer/Footer.astro";
import Header from "@/components/Header/Header.astro";

export interface Props {
  title: string;
  description: string;
  path: string;
}

const path = Astro.props.path;
const { title, description } = Astro.props;
const canonicalUrl = `https://www.dylf.dev${Astro.url.pathname}`;
const pageTitle = `${title} | Dylan Fontaine`;
const isGallery = path === "/gallery";
const linkPath = isGallery ? "/" : "/gallery";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="follow, index" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dylan Fontaine" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ShallowClone" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="stylesheet" href={globalStylesHref} />

    <link rel="icon" type="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <SpeedInsights />
    <script>
      async function updateLiveStatus() {
        const liveStatus = document.getElementById("live-status");
        const liveStatusLink = document.getElementById("live-status-link");

        if (!liveStatus || !liveStatusLink) return;

        try {
          const response = await fetch("/api/live.json");

          if (!response.ok) return;

          const data = await response.json();

          if (data.live) {
            liveStatus.classList.add("hidden");
            liveStatusLink.classList.remove("hidden");
          }
        } catch {
          // Keep default "I am not alive" text when Twitch lookup fails.
        }
      }

      updateLiveStatus();
      document.addEventListener("astro:page-load", updateLiveStatus);
    </script>
  </head>
  <body class="selection:bg-purple-900">
    <div
      class="container mx-auto max-w-360 grid-cols-1 gap-4 md:grid-cols-[18rem_1fr_150px]"
    >
      <Header currentPath={path} />
      <aside class="flex h-full flex-col">
        <div class="flex-1">
          <slot name="sidebar" />
          <div class="mt-9 flex w-12 flex-col">
            <span id="live-status" class="text-lg text-amber-500 lowercase">
              I may not be on the internet right now</span
            >
            <a
              id="live-status-link"
              href="https://www.twitch.tv/shallowclone"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden animate-pulse text-2xl font-bold text-purple-400 uppercase hover:text-purple-400 hover:underline"
            >
              I am alive on Twitch &rarr;
            </a>
          </div>
        </div>
        <div>
          <a
            href={linkPath}
            class:list={[
              "flex-end",
              "justify-end",
              "hover:text-cyan-300",
              "text-red-900",
              "font-light",
              "hover:underline",
              "ease-in",
              "duration-100",
              "text-lg",
            ]}
          >
            {
              isGallery ? (
                <>
                  <span class="text-xl">&larr;</span>
                  Please leave
                </>
              ) : (
                <>
                  Don't go here
                  <span class="text-xl">&rarr;</span>
                </>
              )
            }
          </a>
        </div>
      </aside>
      <main class="flex-1 md:col-[2_/_-1]">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
